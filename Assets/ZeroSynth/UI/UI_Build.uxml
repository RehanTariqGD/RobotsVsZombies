<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="UI_Theme.uss" />
    <ui:VisualElement name="build-screen" class="screen" picking-mode="Ignore" style="display: none;">
        <ui:VisualElement name="safe-area" class="safe-area" picking-mode="Ignore">
            <ui:VisualElement class="build-content" picking-mode="Ignore">
                <ui:Label name="paused-pill" text="TACTICAL PAUSE" class="hud-pill build-paused-pill" picking-mode="Ignore" style="display: none;" />
                <ui:VisualElement class="build-spacer" picking-mode="Ignore" />
                <ui:VisualElement class="build-dock" picking-mode="Ignore">
                    <ui:Label name="build-toast" class="build-toast" picking-mode="Ignore" style="display: none;" />
                    <ui:VisualElement name="build-bar" class="panel build-bar blocks-input">
                        <ui:Button name="tactical-pause-button" text="PAUSE" class="button build-button" />
                        <ui:VisualElement name="build-options" class="build-options" />
                        <ui:Button name="cancel-button" text="CANCEL" class="button button--danger build-button" style="display: none;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
