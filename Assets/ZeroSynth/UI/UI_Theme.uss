:root {
    --background: #0E1216;
    --panel: #161C23;
    --panel-raised: #1E2630;
    --border: #2B3642;
    --text: #E6E1CF;
    --text-dim: #8B95A1;
    --accent: #33D9FF;
    --warning: #F2A01F;
    --danger: #CC141F;
    --ok: #5C7338;
    color: var(--text);
    font-size: 20px;
}
.screen { flex-grow: 1; }
.screen--menu { background-color: var(--background); }
.safe-area, .game-content { flex-grow: 1; }
.backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--border);
    border-radius: 4px;
    padding: 20px;
}
.title { font-size: 42px; -unity-font-style: bold; letter-spacing: 3px; margin-bottom: 12px; }
.subtitle { color: var(--accent); font-size: 16px; letter-spacing: 2px; white-space: normal; margin-bottom: 24px; }
.button {
    min-height: 64px;
    min-width: 220px;
    flex-shrink: 0;
    margin: 6px 0;
    padding: 12px 20px;
    background-color: var(--panel-raised);
    border-width: 2px;
    border-color: var(--border);
    border-radius: 3px;
    color: var(--text);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}
.button:hover, .button:focus { border-color: var(--accent); }
.button:active { background-color: var(--border); }
.button:disabled { color: var(--text-dim); opacity: 0.5; }
.button--primary { background-color: var(--accent); border-color: var(--accent); color: var(--background); }
.button--danger { border-color: var(--danger); }
.label-dim { color: var(--text-dim); font-size: 16px; }
.bar { height: 22px; background-color: var(--background); border-width: 1px; border-color: var(--border); overflow: hidden; }
.bar__fill { height: 100%; width: 100%; background-color: var(--ok); }
.bar__fill--warning { background-color: var(--warning); }
.bar__fill--danger { background-color: var(--danger); }
.stat-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.slider-row, .toggle-row { min-height: 64px; margin-bottom: 12px; align-items: center; }
.slider-row > .unity-base-field__label, .toggle-row > .unity-base-field__label { min-width: 150px; color: var(--text); }
.slider-row .unity-base-slider__dragger { width: 32px; height: 32px; margin-top: -14px; border-radius: 3px; background-color: var(--accent); }
.slider-row .unity-base-slider__tracker { height: 4px; background-color: var(--border); }
.slider-row .unity-base-popup-field__input { min-height: 56px; background-color: var(--panel-raised); color: var(--text); }
.toggle-row .unity-toggle__checkmark { width: 32px; height: 32px; }
.hud-pill { background-color: var(--panel-raised); border-width: 1px; border-color: var(--border); border-radius: 3px; padding: 10px 14px; margin-left: 8px; -unity-font-style: bold; }
.menu-column { width: 33.33%; min-width: 320px; max-width: 520px; flex-grow: 1; justify-content: center; padding: 24px; background-color: rgba(14, 18, 22, 0.92); }
.menu-column .title { font-size: 36px; }
.logo { height: 96px; margin-bottom: 8px; -unity-background-scale-mode: scale-to-fit; display: none; }
.logo--ready { display: flex; }
.version { margin-top: 20px; }
.overlay, .settings-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(14, 18, 22, 0.94); }
.settings-overlay { display: none; }
.settings-card { width: 640px; max-width: 96%; max-height: 100%; }
.settings-scroll { flex-shrink: 1; }
.pause-panel, .outcome-panel { width: 580px; max-width: 96%; max-height: 100%; }
.button-row { flex-direction: row; justify-content: space-between; }
.button-row .button { flex-grow: 1; margin-left: 4px; margin-right: 4px; }
.hud { flex-grow: 1; padding: 16px; }
.hud-top { flex-direction: row; align-items: flex-start; justify-content: space-between; }
.hud-wave { width: 28%; }
.hud-core { width: 32%; padding: 12px; }
.hud-resources { width: 36%; align-items: flex-end; }
.resource-row { flex-direction: row; }
.hud-heading { font-size: 24px; -unity-font-style: bold; }
.core-label { -unity-text-align: middle-center; margin-bottom: 8px; }
